{
  "name": "@kyo-so/cli",
  "version": "0.16.10",
  "description": "Kyo-so: MCP-native, ACP-powered multi-agent review gates for AI coding workflows.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hokupod/kyoso.git"
  },
  "homepage": "https://github.com/hokupod/kyoso#readme",
  "bugs": {
    "url": "https://github.com/hokupod/kyoso/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kyoso": "dist/bin/kyoso.js",
    "kyoso-budget-report": "scripts/review-budget-report.mjs"
  },
  "files": [
    "dist",
    "scripts/review-budget-report.mjs",
    ".agents/skills/kyoso-review",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli/main.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --target=node --outfile dist/index.js && bun build src/cli/main.ts --target=node --outfile dist/bin/kyoso.js --banner '#!/usr/bin/env node' && node -e \"require('node:fs').chmodSync('dist/bin/kyoso.js', 0o755)\" && node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:openrouter:codex-acp": "bun run src/cli/main.ts openrouter-acp-smoke",
    "plugin:sync": "node scripts/plugin-sync.mjs",
    "plugin:verify": "node scripts/verify-plugin.mjs",
    "plugin:verify:registry": "node scripts/verify-plugin-registry.mjs",
    "plugin:verify:published-cli": "node scripts/verify-published-cli.mjs",
    "plugin:runtime:migrate": "node scripts/plugin-runtime-contract-migrate.mjs",
    "plugin:runtime:verify": "node scripts/verify-plugin-runtime.mjs",
    "plugin:promote": "node scripts/plugin-promote.mjs",
    "plugin:promotion:reconcile": "node scripts/plugin-promotion-issues.mjs",
    "skill:runtime:verify": "node scripts/verify-skill-runtime.mjs",
    "audit:runtime:verify": "node scripts/verify-audit-runtime.mjs",
    "audit:budget-report": "node scripts/review-budget-report.mjs",
    "pack:verify": "node scripts/verify-pack.mjs",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@modelcontextprotocol/server": "2.0.0",
    "smol-toml": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@typescript/typescript6": "6.0.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
