{
  "name": "@kyo-so/cli",
  "version": "0.9.0",
  "description": "Kyo-so: MCP-native, ACP-powered multi-agent review gates for AI coding workflows.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hokupod/kyoso.git"
  },
  "homepage": "https://github.com/hokupod/kyoso#readme",
  "bugs": {
    "url": "https://github.com/hokupod/kyoso/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kyoso": "dist/bin/kyoso.js"
  },
  "files": [
    "dist",
    ".agents/skills/kyoso-review",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --target=node --outfile dist/index.js && bun build src/cli/main.ts --target=node --outfile dist/bin/kyoso.js --banner '#!/usr/bin/env node' && node -e \"require('node:fs').chmodSync('dist/bin/kyoso.js', 0o755)\" && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "plugin:sync": "node scripts/plugin-sync.mjs",
    "plugin:verify": "node scripts/verify-plugin.mjs",
    "plugin:verify:registry": "node scripts/verify-plugin-registry.mjs",
    "plugin:runtime:verify": "node scripts/verify-plugin-runtime.mjs",
    "plugin:promote": "node scripts/plugin-promote.mjs",
    "skill:runtime:verify": "node scripts/verify-skill-runtime.mjs",
    "audit:runtime:verify": "node scripts/verify-audit-runtime.mjs",
    "pack:verify": "node scripts/verify-pack.mjs",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@modelcontextprotocol/server": "2.0.0-beta.2",
    "smol-toml": "1.7.0",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.9.5"
  }
}
