{
  "name": "@kyoso/cli",
  "version": "0.1.0",
  "description": "Kyo-so: MCP-native, ACP-powered multi-agent review gates for AI coding workflows.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kyoso": "./dist/bin/kyoso.js"
  },
  "files": [
    "dist",
    ".agents/skills/kyoso-review",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --target=node --outfile dist/index.js && bun build src/cli/main.ts --target=node --outfile dist/bin/kyoso.js && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.0.0",
    "@modelcontextprotocol/server": "2.0.0-alpha.3",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.9.1"
  }
}
