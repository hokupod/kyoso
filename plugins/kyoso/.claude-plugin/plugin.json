{
  "name": "kyoso",
  "version": "0.7.21",
  "description": "Multi-agent review gates powered by Codex and Claude.",
  "author": {
    "name": "hokupod",
    "url": "https://github.com/hokupod"
  },
  "homepage": "https://github.com/hokupod/kyoso",
  "repository": "https://github.com/hokupod/kyoso",
  "license": "AGPL-3.0-or-later",
  "keywords": ["review", "multi-agent", "codex", "claude"],
  "skills": "./skills/",
  "mcpServers": {
    "kyoso": {
      "command": "npx",
      "args": [
        "-y",
        "--package=kyoso-cli@npm:@kyo-so/cli@0.16.12",
        "kyoso",
        "mcp"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY:-}",
        "CLAUDE_CODE_OAUTH_TOKEN": "${CLAUDE_CODE_OAUTH_TOKEN:-}",
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY:-}"
      }
    }
  }
}
